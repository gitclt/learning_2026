<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Certificate</title>
@*     <link href="~wwwroot/templates/certificate.css" rel="stylesheet" />
 *@

 <link rel="stylesheet" href="CSS_URL/certificate.css" />
</head>
<body>

    <div class="certificate">
        <div class="header">
            <img src="IMAGE_BASE_URL/KALANJALI_2025.png" class="bannerImg" />
        </div>
  

        <div class="goldCurve"></div>

        <div class="certificateBody">

            <div class="flag">
                <img src="IMAGE_BASE_URL/qatar-india.png" />
            </div>

            <div class="certificateTitle">CERTIFICATE</div>
            <div class="subTitle">OF APPRECIATION</div>
            <div class="presented">THIS CERTIFICATE IS PRESENTED TO</div>

            <table class="details">
                <tr>
                    <td class="label">Name :</td>
                    <td class="line">{{Name}}</td>
                    <td class="label">Class :</td>
                    <td class="smallLine">{{Class}}</td>
                </tr>
                <tr>
                    <td class="label">School :</td>
                    <td class="line">{{School}}</td>
                    <td class="label">Item code :</td>
                    <td class="smallLine">{{ItemCode}}</td>
                </tr>
                <tr>
                    <td class="label">Item :</td>
                    <td class="line">{{Item}}</td>
                    <td class="label">Position :</td>
                    <td class="smallLine">{{Position}}</td>
                </tr>
                <tr>
                    <td class="label">Grade :</td>
                    <td class="line">{{Grade}}</td>
                    <td></td>
                    <td></td>
                </tr>
            </table>

        </div>

        <div class="signatureSection">
            <div class="sign">
                <img src="IMAGE_BASE_URL/sign1.png" />
                <h4>Chief Patron</h4>
                <p>H.E. MR. VIPUL</p>
                <span>Ambassador of India to Qatar</span>
            </div>
            <div class="sign">
                <img src="IMAGE_BASE_URL/sign2.png" />
                <h4>Patron</h4>
                <p>Manikantan A.P</p>
                <span>ICC President</span>
            </div>
            <div class="sign">
                <img src="IMAGE_BASE_URL/sign3.png" />
                <h4>Chairperson</h4>
                <p>Dr. Hassan Kunhi</p>
            </div>
            <div class="sign">
                <img src="IMAGE_BASE_URL/sign4.png" />
                <h4>President</h4>
                <p>Binu Kumar G</p>
            </div>
            <div class="sign">
                <img src="IMAGE_BASE_URL/sign5.png" />
                <h4>General Secretary</h4>
                <p>Anwar Hussein</p>
            </div>
        </div>

    </div>

</body>
</html>